# Template for the local .env file. Copy it to .env and fill in the values:
#
#   cp .env.example .env
#
# Variables in .env are loaded automatically by `ante.config` using the
# `python-dotenv` package, so they're available via `os.environ`:
#
#   import os
#   import ante.config  # noqa: F401
#
#   api_key = os.environ["API_KEY"]
#
# Commit this file with variable names and placeholder values only.
# Never put real secrets here; those belong in .env, which is not committed.

# EXAMPLE_API_KEY=your-api-key-here
